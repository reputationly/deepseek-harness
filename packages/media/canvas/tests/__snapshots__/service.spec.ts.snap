// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`canvas tools > builds a connected, grouped canvas in one call and reads it back 1`] = `
"- n1 text "Brief" text="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx…"
- n2 image "a.png" path=<project>/a.png group=g4
- n3 image "b.png" path=<project>/b.png group=g4
- g4 group "References" members=n2,n3
Edges: n1->n2"
`;

exports[`canvas tools > shows the model one schema per tool 1`] = `
[
  {
    "description": "Read the project canvas the user sees beside the conversation: its nodes, groups with their members, and edges.",
    "name": "canvas_get",
    "parameters": {
      "properties": {
        "nodes": {
          "description": "Node or group ids to read in full. Omit to list the whole canvas with long text and prompts shortened.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Edit the project canvas with an ordered list of operations applied together. Nodes are positioned automatically. An operation that cannot apply is skipped and reported while the others still apply.",
    "name": "canvas_edit",
    "parameters": {
      "properties": {
        "operations": {
          "description": "Operations in the order they apply.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "from": {
                "description": "Node or group the edge starts at: the input or source material.",
                "type": "string",
              },
              "group": {
                "description": "Existing group that the added node joins.",
                "type": "string",
              },
              "node": {
                "description": "Node that update, remove, or ungroup acts on.",
                "type": "string",
              },
              "nodes": {
                "description": "Nodes that the new group frames.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "op": {
                "description": "add creates a node from type plus text or path. update changes title, text, or path of node. remove deletes node. connect and disconnect take from and to. group frames nodes under title. ungroup dissolves the group node and keeps its members.",
                "enum": [
                  "add",
                  "update",
                  "remove",
                  "connect",
                  "disconnect",
                  "group",
                  "ungroup",
                ],
                "type": "string",
              },
              "path": {
                "description": "File of an image, video, or audio node.",
                "type": "string",
              },
              "ref": {
                "description": "Name for the node that add or group creates, usable wherever a node id is expected in later operations of this call.",
                "type": "string",
              },
              "text": {
                "description": "Content of a text node.",
                "type": "string",
              },
              "title": {
                "description": "Short label shown on the node or group.",
                "type": "string",
              },
              "to": {
                "description": "Node or group the edge points to: what was made from, or depends on, from.",
                "type": "string",
              },
              "type": {
                "enum": [
                  "image",
                  "video",
                  "audio",
                  "text",
                ],
                "type": "string",
              },
            },
            "required": [
              "op",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "operations",
      ],
      "type": "object",
    },
  },
]
`;
