// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`canvas tools > builds a connected, grouped canvas in one call and reads it back 1`] = `
"Revision 1 · episode e1 "Canvas" · no project.json · no bible.json
- n1 text "Brief" v=v1 text="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx…"
- n2 image "a.png" v=v1 group=g4 path=<project>/a.png inputs=prompt n1
- n3 image "b.png" v=v1 group=g4 path=<project>/b.png
- g4 group "References" members=n2,n3
Edges: n1->n2:prompt"
`;

exports[`canvas tools > shows the model one schema per tool 1`] = `
[
  {
    "description": "Read the project canvas the user sees beside the conversation: its nodes, groups with their members, and edges. Nodes report their active version, generation inputs, and whether their storyboard or inputs changed since they were made.",
    "name": "canvas_get",
    "parameters": {
      "properties": {
        "detail": {
          "description": "summary shortens long text; full keeps it and returns the shots of each storyboard.",
          "enum": [
            "summary",
            "full",
          ],
          "type": "string",
        },
        "include": {
          "description": "bible adds the shared style and entries; project adds the production format and episodes.",
          "items": {
            "enum": [
              "bible",
              "project",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "nodes": {
          "description": "Node or group ids to read in full. Omit to list the whole canvas with long text shortened.",
          "items": {
            "type": "string",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
  },
  {
    "description": "Edit the project canvas with an ordered list of operations applied together. Nodes are positioned automatically. baseRevision is the revision canvas_get returned; a stale revision is refused instead of overwriting newer work. An operation that cannot apply is skipped and reported while the others still apply.",
    "name": "canvas_edit",
    "parameters": {
      "properties": {
        "baseRevision": {
          "description": "Revision canvas_get returned for the canvas this call edits.",
          "type": "integer",
        },
        "operations": {
          "description": "Operations in the order they apply.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "after": {
                "description": "Shot id the moved or inserted shot follows; omit to append.",
                "type": "string",
              },
              "bible": {
                "description": "Bible entry this image belongs to.",
                "type": "string",
              },
              "from": {
                "description": "Node the edge starts at: the input or source material.",
                "type": "string",
              },
              "genKind": {
                "description": "What the node generates.",
                "enum": [
                  "image",
                  "video",
                  "speech",
                  "music",
                ],
                "type": "string",
              },
              "group": {
                "description": "Existing group the added node joins.",
                "type": "string",
              },
              "model": {
                "description": "Model id for generation.",
                "type": "string",
              },
              "node": {
                "description": "Node that the operation acts on.",
                "type": "string",
              },
              "nodes": {
                "description": "Nodes that the new group frames.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "op": {
                "description": "add creates a node from type plus text, path, shots, or prompt. update changes title, text, or path. set_gen changes how a media node generates and takes params where null deletes a parameter. set_text and set_shots store a new version; update_shot, insert_shot, remove_shot, and move_shot edit one shot. set_version switches the active version. connect and disconnect take from and to, with an optional role. reorder_refs rewrites the reference order. group frames nodes under title; ungroup dissolves the group.",
                "enum": [
                  "add",
                  "update",
                  "remove",
                  "set_gen",
                  "set_text",
                  "set_shots",
                  "update_shot",
                  "insert_shot",
                  "remove_shot",
                  "move_shot",
                  "set_version",
                  "connect",
                  "disconnect",
                  "reorder_refs",
                  "group",
                  "ungroup",
                ],
                "type": "string",
              },
              "order": {
                "description": "Position among the reference inputs.",
                "type": "integer",
              },
              "params": {
                "additionalProperties": true,
                "description": "Generation parameters; null deletes one.",
                "properties": {},
                "type": "object",
              },
              "patch": {
                "additionalProperties": true,
                "description": "Shot fields update_shot replaces.",
                "properties": {},
                "type": "object",
              },
              "path": {
                "description": "File of an image, video, or audio node.",
                "type": "string",
              },
              "prompt": {
                "description": "Prompt of a generated node; may mention bible entries as @name.",
                "type": "string",
              },
              "ref": {
                "description": "Name for the node that add or group creates, usable wherever a node id is expected later in this call.",
                "type": "string",
              },
              "role": {
                "description": "What the edge supplies. Inferred from node types when omitted.",
                "enum": [
                  "prompt",
                  "ref",
                  "first_frame",
                  "last_frame",
                  "audio",
                  "source",
                ],
                "type": "string",
              },
              "shot": {
                "description": "Shot id that the operation acts on.",
                "type": "string",
              },
              "shots": {
                "description": "Shots of a storyboard, or the shot insert_shot adds.",
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "camera": {
                      "description": "Camera movement, or 固定 when the camera holds.",
                      "type": "string",
                    },
                    "characters": {
                      "description": "Bible entry ids of the characters on screen.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "dialogue": {
                      "description": "Spoken lines of the shot, in order.",
                      "items": {
                        "additionalProperties": false,
                        "properties": {
                          "id": {
                            "description": "Line id such as d1; omit to number the lines of the shot.",
                            "type": "string",
                          },
                          "line": {
                            "description": "What the speaker says, as written.",
                            "type": "string",
                          },
                          "speaker": {
                            "description": "Bible entry id of the speaker; omit the field for narration.",
                            "type": "string",
                          },
                        },
                        "required": [
                          "line",
                        ],
                        "type": "object",
                      },
                      "type": "array",
                    },
                    "durationSec": {
                      "description": "Shot length in seconds.",
                      "type": "number",
                    },
                    "id": {
                      "description": "Shot id such as s1; omit to number the shots of the table.",
                      "type": "string",
                    },
                    "motion": {
                      "description": "What the characters do in the shot.",
                      "type": "string",
                    },
                    "negative": {
                      "description": "What this shot must not show.",
                      "type": "string",
                    },
                    "props": {
                      "description": "Bible entry ids of the props on screen.",
                      "items": {
                        "type": "string",
                      },
                      "type": "array",
                    },
                    "scene": {
                      "description": "Bible entry id of the location.",
                      "type": "string",
                    },
                    "sfx": {
                      "description": "Sound effects of the shot.",
                      "type": "string",
                    },
                    "shotSize": {
                      "description": "Camera framing; gate G2 needs it before a video is generated.",
                      "enum": [
                        "extreme_wide",
                        "wide",
                        "full",
                        "medium",
                        "medium_close",
                        "close",
                        "extreme_close",
                        "insert",
                      ],
                      "type": "string",
                    },
                    "title": {
                      "description": "Short title of the shot, at most 24 characters.",
                      "type": "string",
                    },
                    "visual": {
                      "description": "What the frame shows.",
                      "type": "string",
                    },
                  },
                  "type": "object",
                },
                "type": "array",
              },
              "sources": {
                "description": "Reference sources in the order reorder_refs applies.",
                "items": {
                  "type": "string",
                },
                "type": "array",
              },
              "text": {
                "description": "Content of a text or script node.",
                "type": "string",
              },
              "title": {
                "description": "Short label shown on the node or group.",
                "type": "string",
              },
              "to": {
                "description": "Node the edge points to: what was made from, or depends on.",
                "type": "string",
              },
              "type": {
                "enum": [
                  "image",
                  "video",
                  "audio",
                  "text",
                  "script",
                  "storyboard",
                  "timeline",
                ],
                "type": "string",
              },
              "version": {
                "description": "Version id set_version activates.",
                "type": "string",
              },
            },
            "required": [
              "op",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "required": [
        "operations",
        "baseRevision",
      ],
      "type": "object",
    },
  },
]
`;
